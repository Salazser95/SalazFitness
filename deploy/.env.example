# Copia este fichero a deploy/.env y rellena los valores.
# deploy/.env NO va al repositorio (esta en .gitignore).

# ------------------------------------------------------------------ Django
# Genera una clave nueva y larga. Por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SALAZ_SECRET_KEY=cambiame

# Dominios desde los que se sirve, separados por comas.
#
# IMPORTANTE si usas el tunel de Cloudflare (ver docs/ACCESO-REMOTO.md): aqui
# va el dominio del TUNEL, no una IP local. Con el modo con nombre, tu
# dominio de siempre (salazfitness.tudominio.com). Con el modo rapido, la URL
# que Cloudflare asigna al azar (algo-al-azar.trycloudflare.com) -- y como esa
# URL cambia cada vez que reinicias el contenedor del tunel, para no tener que
# tocar esta variable en cada prueba puedes poner el comodin de sufijo
# ".trycloudflare.com" (con el punto delante: Django ya entiende ese formato
# como "cualquier subdominio de trycloudflare.com"). Es comodo para probar,
# pero deja pasar CUALQUIER tunel rapido de CUALQUIERA, no solo el tuyo: no lo
# dejes puesto en un uso que no sea una prueba tuya de un rato.
# Ejemplo con el modo rapido: SALAZ_ALLOWED_HOSTS=.trycloudflare.com
SALAZ_ALLOWED_HOSTS=salazfitness.tudominio.com

# Direccion publica de la app: es la que se pone en el enlace del correo
# de confirmacion, asi que tiene que ser la que abre el usuario. Con el tunel,
# la URL del tunel (https://...trycloudflare.com o tu dominio), nunca la IP
# local del portatil.
SALAZ_APP_URL=https://salazfitness.tudominio.com

# Pon 0 mientras pruebas sin certificado; a 1 en cuanto tengas HTTPS. Con el
# tunel de Cloudflare SIEMPRE hay HTTPS real desde el primer minuto (lo pone
# Cloudflare, no hace falta certificado propio), asi que se deja en 1.
SALAZ_FORCE_HTTPS=1

# ------------------------------------------------------------------- MySQL
SALAZ_DB_NAME=salazfitness
SALAZ_DB_USER=salaz
SALAZ_DB_PASSWORD=cambiame-tambien
SALAZ_DB_HOST=db
SALAZ_DB_PORT=3306
# Contrasena de root de MySQL, solo la usa el contenedor de la base de datos.
MYSQL_ROOT_PASSWORD=cambiame-root

# -------------------------------------------------------------------- SMTP
# Sin esto no se puede confirmar ninguna cuenta y el backend no arranca.
# Con Gmail hay que usar una "contrasena de aplicacion", no la del correo.
#
# PARA UNA PRIMERA PRUEBA SIN SMTP: pon SALAZ_EMAIL_CONSOLA=1 y deja
# SALAZ_EMAIL_HOST vacio. Los correos se imprimen en los logs en vez de
# enviarse, el backend arranca igual, y se entra con el usuario de prueba de
# mas abajo (que no necesita confirmar nada). Quien se registre desde la app
# NO recibira su correo y no podra entrar: es solo para probar.
SALAZ_EMAIL_CONSOLA=
SALAZ_EMAIL_HOST=smtp.gmail.com
SALAZ_EMAIL_PORT=587
SALAZ_EMAIL_USER=tucorreo@gmail.com
SALAZ_EMAIL_PASSWORD=contrasena-de-aplicacion
SALAZ_EMAIL_TLS=1
SALAZ_EMAIL_FROM=SalazFitness <tucorreo@gmail.com>

# ------------------------------------------------------- app movil (opcional)
# Origenes extra con permiso para llamar a la API. La app empaquetada ya viene
# permitida de serie (capacitor://localhost y compania).
SALAZ_CORS_ORIGINS=

# Origenes de confianza para el CSRF de Django, separados por comas y CON el
# esquema (https://...). Si se deja en blanco, se calcula solo a partir de
# SALAZ_ALLOWED_HOSTS (le antepone "https://" a cada uno), asi que en la
# mayoria de los casos no hace falta tocarlo. Ponlo a mano solo si
# SALAZ_ALLOWED_HOSTS lleva el comodin ".trycloudflare.com": ese comodin
# sirve para ALLOWED_HOSTS pero el CSRF de Django no admite comodines, asi que
# hay que escribir aqui la URL exacta del tunel de ese momento.
# Ejemplo: SALAZ_CSRF_ORIGINS=https://algo-al-azar.trycloudflare.com
SALAZ_CSRF_ORIGINS=

# ------------------------------------------------------ acceso remoto (opcional)
# Ver docs/ACCESO-REMOTO.md para la guia completa (por que hace falta HTTPS,
# como sacar la URL, Cloudflare Access, Tailscale como alternativa...).
#
# Token del tunel con nombre de Cloudflare (modo "nombrado" en
# deploy/docker-compose.tunel.yml). Se saca del panel de Cloudflare, en Zero
# Trust > Networks > Tunnels > (tu tunel) > "Install and run a connector".
# No hace falta para el modo rapido (sin cuenta).
CLOUDFLARE_TUNNEL_TOKEN=

# --------------------------------------------------------------- JWT (opcional)
# El login de la app firma su token con una clave RSA propia. Sin esto puesto
# se genera una clave nueva cada vez que arranca el contenedor: la app entra
# igual, pero un reinicio cierra la sesion de todo el mundo (hay que volver a
# entrar). Para que las sesiones sobrevivan a los reinicios, genera una pareja
# fija una vez que el contenedor este arriba (con esto vacio arranca igual):
#   docker compose exec api python manage.py generate-jwt-keys
# y copia aqui las dos lineas que imprime, tal cual.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ------------------------------------------------------- usuario de prueba
# Si pones aqui una contrasena, al arrancar se crea (o se actualiza) el
# usuario "salaz1" con ella, ya verificado. Es la forma de entrar sin tener
# SMTP configurado. Dejalo vacio cuando ya no lo necesites.
SALAZ_CREAR_USUARIO_PRUEBA=
